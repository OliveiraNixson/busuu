
<div class="mx-auto w-full max-w-2xl rounded-2xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8 rounded-lg bg-black/50">

  <div class="mb-8">
    <h2 class="text-2xl font-semibold tracking-tight text-gray-900">
        <%= course.persisted? ? "Edit Course - #{course.name}" : "New Course" %>
    </h2>
    <p class="mt-2 text-sm text-gray-500">
      Enter the information to create a course.
    </p>
  </div>

  <%= simple_form_for course, url: course.persisted? ? language_course_path(course.language, course) : language_courses_path(course.language), html: { class: "space-y-6" } do |f| %>

    <%= f.input :name,
      label: "Course name",
      placeholder: "e.g., Beginner English",
      input_html: {
        class: "w-full p-2 rounded-lg border border-gray-300 px-4 py-3 text-sm shadow-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
      },
      label_html: {
        class: "mb-2 block text-sm font-medium text-gray-700"
      } %>

    <%= f.association :language,
      collection: Language.all,
      label: "Language",
      prompt: "Select a language",
      input_html: {
        class: "py-2 w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-sm shadow-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
      },
      label_html: {
        class: "mb-2 block text-sm font-medium text-gray-700"
      } %>

    <%= f.input :description,
      label: "Description",
      placeholder: "Describe the course content and objectives...",
      input_html: {
        rows: 5,
        class: "w-full rounded-lg border border-gray-300 px-4 py-3 text-sm shadow-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 resize-y"
      },
      label_html: {
        class: "mb-2 block text-sm font-medium text-gray-700"
      } %>

    <div class="flex flex-col gap-2">
      <%= f.collection_check_boxes :level_ids, Level.all, :id, :name, item_label_class:"flex gap-2"  %>
    </div>
    <div class="flex justify-end border-t border-gray-100 pt-6">
      <%= f.button :submit,
        "Save course",
        class: "bg-blue-500 p-2 hover:bg-blue-600 rounded-lg px-6 py-3 text-sm font-semibold text-white shadow-sm transition focus:ring-offset-2 cursor-pointer" %>
    </div>

  <% end %>
</div>
