<div class="container mx-auto px-4 py-8">
  <div class="flex items-center gap-2 item-center mb-6">
    <div class="flex justify-center items-center w-8 aspect-square overflow-hidden rounded-full bg-blue-500">
        <span class="fi fi-<%= @language.flag %> block !size-full rounded-full !bg-cover"
              role="img"
              aria-label="<%= @language.name %>">
        </span>
    </div>
    <h2 class="text-4xl font-bold"><%= @language.name.capitalize %> courses</h2>
  </div>
  <p class="text-lg text-slate-600 mb-6">On going</p>
    <div class="flex flex-row flex-wrap gap-4 gap-6">
      <% @courses.each do |course| %>
       <%= render partial:"course", locals: { course: course } %>
      <% end %>
    </div>
  </div>
</div>