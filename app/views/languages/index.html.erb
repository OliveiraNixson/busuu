<%= turbo_frame_tag "modalcontainer" do %>
    <%= render "layouts/float_modal" do %>
        <div class="flex flex-col items-start gap-4 p-2">

            <div class="flex w-full flex-col gap-4">
               <% @languages.each do |language| %>
                  <details class="group">
                     <summary class="flex cursor-pointer list-none items-center gap-3 rounded-xl p-3 transition-all duration-200 hover:bg-gray-100 [&::-webkit-details-marker]:hidden">

                        <div class="flex size-11 shrink-0 items-center justify-center overflow-hidden rounded-full transition-all duration-200 group-hover:ring-blue-200">
                           <span
                           class="fi fi-<%= language.flag %> block !size-full !bg-cover"
                           role="img"
                           aria-label="<%= language.name %>">
                           </span>
                        </div>

                        <span class="flex-1 text-base font-semibold text-gray-700 transition-colors group-hover:text-blue-600">
                           <%= language.name %>
                        </span>
                     </summary>

                     <div class="flex flex-col gap-2 px-4">

                        <% language.courses.each do |course| %>
                           <%= link_to edit_language_course_path(language, course),
                           class: "group/course flex flex-col gap-5 rounded-xl p-2.5 transition-all duration-200 hover:bg-blue-50 hover:translate-x-1" do %>

                              <span class="flex text-2xs items-center gap-2  text-gray-700 hover:text-blue-600 transition-colors group-hover/course:text-blue-600">
                                 <i class="ti ti-point mr-2"></i> <%= course.name %>
                              </span>

                           <% end %>
                        <% end %>
                     </div>
                  </details>
               <% end %>
            </div>
         </div>
    <% end %>
<% end %>