<% flash.each do |flash_type, message| %>
  <% colors = {
    "notice" => "bg-blue-100 border-blue-500 text-blue-700",
    "success" => "bg-green-100 border-green-500 text-green-700",
    "alert" => "bg-red-100 border-red-500 text-red-700",
    "error" => "bg-red-100 border-red-500 text-red-700"
  } %>

  <div
      data-controller="removals"
      data-action="click->removals#remove" 
      class="mb-4 rounded-lg border-l-4 px-4 py-3 shadow-sm <%= colors[flash_type] || 'bg-gray-100 border-gray-500 text-gray-700' %>">
    <p><%= message %></p>
  </div>
<% end %>