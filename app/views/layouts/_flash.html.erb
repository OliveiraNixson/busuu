<% flash.each do |type, message| %>
  <% css_class =
      case type.to_sym
      when :notice
        "bg-green-100 text-green-800 border-green-300"
      when :alert
        "bg-red-100 text-red-800 border-red-300"
      else
        "bg-blue-100 text-blue-800 border-blue-300"
      end
  %>

  <div class="mb-4 rounded border p-4 <%= css_class %>">
    <%= message %>
  </div>
<% end %>