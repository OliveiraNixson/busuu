<header class="flex items-center justify-between h-20 px-8 border-b border-gray-200 shadom-sm bg-white">
  <div class="flex items-center">
    <%= link_to "#", class: "" do %>
      <h1 class="text-2xl font-bold text-blue-600">
        Busuu Clone
      </h1>
    <% end %>
  </div>

  <div class="flex items-center gap-4">
    <button class="flex items-center justify-center w-10 h-10 text-2xl rounded-full hover:bg-gray-100 transition">
      <%= icon "information-circle", class: "w-5 h-5 text-gray-600" %>
    </button>

    <button class="flex items-center justify-center w-10 h-10 hover:bg-gray-100 transition rounded-full">
      <div class="w-10 h-10 rounded-full overflow-hidden">
        <%= image_tag "svg/gb.svg",
            alt: "Example Image",
            class: "w-full h-full object-cover" %>
      </div>
    </button>

    <button class="flex items-center justify-center w-10 h-10 rounded-full bg-blue-600 text-white font-medium">
      N
    </button>

    <button class="flex items-center justify-center w-10 h-10 rounded-full hover:bg-gray-100 transition">
      <%= icon "bars-3", class: "w-6 h-6 rounded-full text-gray-700" %>
    </button>
  </div>
</header>
