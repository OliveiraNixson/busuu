<header class="bg-white/90 backdrop-blur border-b border-slate-200 sticky top-0 z-50">
  <div class="mx-auto flex items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-4">
        <%= link_to root_path, class: "flex items-center gap-3" do %>
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-600 text-lg font-bold text-white shadow-sm">
            B
        </div>
        <% end %>
        <div class="items-center gap-4 text-sm font-medium text-slate-600 md:flex">
            <%= link_to "Learn", root_path, class: "transition hover:text-blue-600 text-slate-600" %>
            <%= link_to "Courses", root_path, class: "transition hover:text-blue-600" %>
            <%= link_to "Levels", root_path, class: "transition hover:text-blue-600" %>
        </div>
    </div>

    <div class="flex items-center gap-3">

      <%= link_to "#", class: "flex justify-center items-center w-8 aspect-square overflow-hidden rounded-full bg-blue-500" do %>
        <span class="fi fi-br block !size-full rounded-full !bg-cover"
              role="img"
              aria-label="Brasil">
        </span>
      <% end %>

      <%= link_to "#", class: "flex justify-center items-center w-8 aspect-square rounded-full bg-blue-500" do %>
        <div class="text-white font-bold">
          N
        </div>
      <% end %>

      <%= link_to "#", class: "flex justify-center items-center w-8 aspect-square rounded-full bg-blue-500" do %>
        <div class="text-white font-bold">
          <i class="ti ti-menu"></i>
        </div>
      <% end %>

    </div>
  </div>
</header>
