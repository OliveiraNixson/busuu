<div class="w-full min-h-screen flex justify-center items-center bg-blue-400 p-4">
  <div class="bg-white shadow-lg rounded-xl p-8 w-full max-w-md">
    <h2 class="text-center text-3xl font-bold text-gray-800 mb-8">
      Login
    </h2>

    <%= simple_form_for "", url: sessions_path, method: :post do |f| %>
      <div class="flex flex-col gap-5">
        <%= f.input :email,
          label: "Email",
          label_html: { class: "font-medium text-gray-700" },
          input_html: {
            class: "w-full rounded-lg border border-gray-300 px-4 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          } %>

        <%= f.input :password,
          label: "Password",
          label_html: { class: "font-medium text-gray-700" },
          input_html: {
            class: "w-full rounded-lg border border-gray-300 px-4 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          } %>

        <%= f.button :submit,
          "Login",
          class: "w-full bg-blue-500 hover:bg-blue-600 transition-colors duration-200 text-white font-semibold py-3 rounded-lg shadow-sm" %>

        <%= link_to "Sign Up", new_user_path , class:"m-auto hover:text-blue-500 py-2" %>
      </div>
    <% end %>
  </div>
</div>