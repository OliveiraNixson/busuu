<div class="w-full min-h-screen flex justify-center items-center bg-blue-400 p-4">
  <div class="bg-white shadow-lg rounded-xl p-8 w-full max-w-md">
    <h2 class="text-center text-3xl font-bold text-gray-800 mb-8">
      Sign Up
    </h2>

    <%= simple_form_for @user  do |f| %>
      <% if @user.errors.any? %>
        <div class="mb-6 rounded-lg border border-red-200 bg-red-50 p-4">
          <div class="flex items-center gap-2">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5 text-red-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 9v2m0 4h.01M12 3l9 16H3L12 3z" />
            </svg>

            <h2 class="font-semibold text-red-800">
              This form contain errors
            </h2>
          </div>

          <ul class="mt-3 list-disc space-y-1 pl-6 text-sm text-red-700">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <div class="flex flex-col gap-5">
        <%= f.input :name,
          label: "Name",
          label_html: { class: "font-medium text-gray-700" },
          input_html: {
            class: "w-full rounded-lg border border-gray-300 px-4 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          } %>

        <%= f.input :email,
          label: "email",
          label_html: { class: "font-medium text-gray-700" },
          input_html: {
            class: "w-full rounded-lg border border-gray-300 px-4 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          } %>

        <%= f.input :password,
          label: "Password",
          label_html: { class: "font-medium text-gray-700" },
          input_html: {
            class: "w-full rounded-lg border border-gray-300 px-4 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          } %>

        <%= f.input :password_confirmation,
          label: "Password confirmation",
          label_html: { class: "font-medium text-gray-700" },
          input_html: {
            class: "w-full rounded-lg border border-gray-300 px-4 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          } %>

        <%= f.button :submit,
          "Create Account",
          class: "w-full bg-blue-500 hover:bg-blue-600 transition-colors duration-200 text-white font-semibold py-3 rounded-lg shadow-sm" %>

        <%= link_to "Back", new_session_path, class:"m-auto hover:text-blue-500 py-2" %>
      </div>
    <% end %>
  </div>
</div>